PROJECT_NAME=SEO Agent
VERSION=6.2.0
ENVIRONMENT=development
JWT_SECRET_KEY=test-secret-key-123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
DATABASE_URL=sqlite:///./seo_agent.db
REDIS_URL=redis://localhost:6379/0
USE_REDIS_QUEUE=false

# Cache TTL Settings
CACHE_TTL_DEFAULT=300
CACHE_TTL_AI=3600
CACHE_TTL_KEYWORDS=600
CACHE_TTL_METRICS=3600
CACHE_TTL_SERP=3600
CACHE_TTL_SITEMAP=3600
CACHE_TTL_ROBOTS=3600
CACHE_TTL_WHOIS=86400

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
