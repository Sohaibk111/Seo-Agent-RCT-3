# SEO Agent SaaS Development Environment Variables
ENVIRONMENT=development
PROJECT_NAME="SEO Agent API"
VERSION="1.0.0"

# Security Secrets (Minimum 16 characters for dev)
JWT_SECRET_KEY=super-secret-jwt-key-for-development-mode-12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default for dev)
DATABASE_URL=sqlite:///./seo_agent.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# External API Keys
GEMINI_API_KEY=

# Redis & Background Queue
REDIS_URL=redis://localhost:6379/0
USE_REDIS_QUEUE=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Cache TTLs (Seconds)
CACHE_TTL_DEFAULT=300
CACHE_TTL_METRICS=1800
CACHE_TTL_WHOIS=86400
CACHE_TTL_SITEMAP=3600
CACHE_TTL_ROBOTS=3600
CACHE_TTL_KEYWORDS=600
CACHE_TTL_AI=1800
CACHE_TTL_SERP=600

# CORS Allowed Origins
CORS_ORIGINS=*
