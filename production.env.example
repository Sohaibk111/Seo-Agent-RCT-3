# SEO Agent SaaS Production Environment Variables Template
ENVIRONMENT=production
PROJECT_NAME="SEO Agent Production API"
VERSION="1.0.0"

# Security Secrets (MUST be at least 32 cryptographically strong characters)
JWT_SECRET_KEY=CHANGE_THIS_TO_A_32_CHAR_RANDOM_SECRET_KEY_IN_PROD
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Production Database
POSTGRES_DB=seo_agent_prod
POSTGRES_USER=seo_prod_admin
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql://seo_prod_admin:CHANGE_THIS_TO_STRONG_POSTGRES_PASSWORD@postgres:5432/seo_agent_prod
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# External AI Services
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Redis Production Queue & Cache
REDIS_URL=redis://redis:6379/0
USE_REDIS_QUEUE=true

# Production Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# Cache TTL Settings (Seconds)
CACHE_TTL_DEFAULT=600
CACHE_TTL_METRICS=1800
CACHE_TTL_WHOIS=86400
CACHE_TTL_SITEMAP=3600
CACHE_TTL_ROBOTS=3600
CACHE_TTL_KEYWORDS=600
CACHE_TTL_AI=1800
CACHE_TTL_SERP=600

# CORS Security (Comma-separated list of allowed domain origins)
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
