  "panels": [
    {
      "title": "API Request Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(seo_request_duration_seconds_sum[5m]) / rate(seo_request_duration_seconds_count[5m])",
          "legendFormat": "Avg Latency (s)"
        }
      ]
    },
    {
      "title": "HTTP Error Rate & 429 Rate Limiting",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(request_count{status_code=~"5.."}[5m]))",
          "legendFormat": "5xx Error Rate"
        },
        {
          "expr": "sum(rate(request_count{status_code="429"}[5m]))",
          "legendFormat": "429 Rate Limited"
        }
      ]
    },
    {
      "title": "Worker Queue Size & Pending Jobs",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "worker_queue_size",
          "legendFormat": "Queue Length"
        },
        {
          "expr": "active_jobs",
          "legendFormat": "Active Executing Jobs"
        }
      ]
    },
    {
      "title": "Job Success Rate & Failure Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "rate(successful_jobs[5m])",
          "legendFormat": "Successful Jobs/sec"
        },
        {
          "expr": "rate(failed_jobs[5m])",
          "legendFormat": "Failed Jobs/sec"
        },
        {
          "expr": "dead_letter_jobs",
          "legendFormat": "Dead Letter Queue"
        }
      ]
    },
    {
